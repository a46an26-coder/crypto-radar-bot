# ==================== НАСТРОЙКИ ПО УМОЛЧАНИЮ ====================
DEFAULT_SETTINGS = {
    "stop_loss": 2.0, "take_profit": 8.0, "max_amount": 1.5,
    "min_price_change": 0.15, "confidence_threshold": 50,
    "auto_trade_enabled": True, "sniper_enabled": True,
